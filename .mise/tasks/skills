#!/usr/bin/env bash
#MISE description="Manage kerpo-skills package: audit, install, uninstall, deploy"
#USAGE cmd "audit" help="Fast apm audit of all skill markdown (unicode/structure, no evals)"
#USAGE cmd "lint" help="Run shellcheck on all skill scripts"
#USAGE cmd "test" help="Run bats tests"
#USAGE cmd "evals" help="Run output quality evals for all skills (needs opencode CLI)"
#USAGE cmd "triggers" help="Run trigger accuracy tests for all skills (needs opencode CLI)"
#USAGE cmd "install" help="Pack and install skills locally (claude + cursor + opencode)" {
#USAGE   flag "-g --global" help="Install to user scope (~/.claude, ~/.agents, ~/.config/opencode) instead of this project"
#USAGE }
#USAGE cmd "uninstall" help="Remove deployed kerpo-* skills (destructive)" {
#USAGE   flag "-y --yes" help="Confirm destructive uninstall"
#USAGE   flag "-g --global" help="Remove from user scope instead of this project"
#USAGE }
#USAGE cmd "deploy" help="Pack, install, git add/commit/push (mutating; requires confirmation)" {
#USAGE   flag "-y --yes" help="Confirm git commit and push"
#USAGE }
set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

cmd="${usage_cmd:-}"
if [[ -z "$cmd" ]]; then
  cat <<'EOF'
Usage: mise run skills -- <subcommand> [flags]

Subcommands:
  audit                       Fast apm audit of skill markdown (unicode/structure, no evals)
  lint                        Run shellcheck on all skill scripts
  test                        Run bats tests under tests/mise-tasks
  evals                       Run output quality evals for all skills (needs opencode CLI)
  triggers                    Run trigger accuracy tests for all skills (needs opencode CLI)
  install [-g|--global]       Pack and install skills (project or user scope)
  uninstall -y|--yes [-g]     Remove deployed kerpo-* skills (destructive)
  deploy -y|--yes             Pack, install, then git add/commit/push (mutating)

Run `mise run skills --help` for full usage.
EOF
  exit 0
fi

yes="${usage_yes:-false}"
global="${usage_global:-false}"

cmd_audit() {
  ./scripts/audit-skills.sh
}

cmd_lint() {
  local -a files=()
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    files+=("$f")
  done < <(find scripts .mise/tasks -type f \( -name '*.sh' -o -path './.mise/tasks/*' ! -name '*.*' \) ! -name '.*' | sort)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "Info: no shell scripts to lint" >&2
    return 0
  fi
  shellcheck "${files[@]}"
  echo "shellcheck ok (${#files[@]} file(s))"
}

cmd_test() {
  if [[ ! -d tests/mise-tasks ]]; then
    echo "Error: tests/mise-tasks missing" >&2
    exit 1
  fi
  # raw=true + exec: avoid mise output-wrapper deadlocks with bats' `run` helper.
  exec bats tests/mise-tasks
}

cmd_evals() {
  local skill_name
  local count
  local total=0
  local evaluated=0

  while IFS= read -r skill_name; do
    [[ -n "$skill_name" ]] || continue
    local evals_file=".apm/skills/$skill_name/evals/evals.json"
    [[ -f "$evals_file" ]] || continue
    count=$(jq 'if type == "array" then length else (.evals | length) end' "$evals_file" 2>/dev/null || echo 0)
    total=$((total + count))
    if [[ "$count" -gt 0 ]]; then
      ./scripts/run-evals.sh "$skill_name"
      evaluated=$((evaluated + 1))
    fi
  done < <(list_skills)

  echo "Evals summary: $evaluated skill(s) evaluated, $total eval case(s)"
}

cmd_triggers() {
  local skill_name
  local total_passed=0
  local total_failed=0
  local skill_count=0

  while IFS= read -r skill_name; do
    [[ -n "$skill_name" ]] || continue
    skill_count=$((skill_count + 1))

    local result passed failed
    result=$(./scripts/test-triggers.sh "$skill_name" 1 2>&1 || true)
    passed=$(echo "$result" | grep -c '\[PASS\]' || true)
    failed=$(echo "$result" | grep -c '\[FAIL\]' || true)

    total_passed=$((total_passed + passed))
    total_failed=$((total_failed + failed))

    echo "$skill_name: $passed passed, $failed failed"
  done < <(list_skills)

  echo ""
  echo "Total: $total_passed passed, $total_failed failed out of $skill_count skills"

  if [[ "$total_failed" -gt 0 ]]; then
    exit 1
  fi
}

list_skills() {
  find .apm/skills -name 'evals.json' | while IFS= read -r f; do
    dirname "$(dirname "$(dirname "$f")")" | xargs basename
  done | sort -u
}

cmd_install() {
  rm -rf build/
  apm pack
  # shellcheck disable=SC2086
  if [[ "$global" == "true" ]]; then
    apm install -g build/kerpo-skills-*
  else
    apm install build/kerpo-skills-*
  fi
}

cmd_uninstall() {
  if [[ "$yes" != "true" ]]; then
    echo "Error: uninstall is destructive. Re-run with --yes" >&2
    exit 1
  fi
  local -a dirs=()
  if [[ "$global" == "true" ]]; then
    dirs=("$HOME/.claude/skills"/kerpo-* "$HOME/.agents/skills"/kerpo-* "$HOME/.config/opencode/skills"/kerpo-*)
  else
    dirs=(".agents/skills"/kerpo-* ".claude/skills"/kerpo-* ".opencode/skills"/kerpo-*)
  fi
  local removed=0
  local d
  for d in "${dirs[@]}"; do
    if [[ -e "$d" ]]; then
      rm -rf "$d"
      removed=$((removed + 1))
    fi
  done
  echo "Removed $removed kerpo-* skill(s) from $([[ "$global" == "true" ]] && echo "user scope" || echo "this project")"
}

cmd_deploy() {
  if [[ "$yes" != "true" ]]; then
    echo "Error: deploy runs git add/commit/push. Re-run with --yes" >&2
    exit 1
  fi
  cmd_install
  git add -A
  git commit -m 'Deploy skills'
  git push
}

case "$cmd" in
  audit) cmd_audit ;;
  lint) cmd_lint ;;
  test) cmd_test ;;
  evals) cmd_evals ;;
  triggers) cmd_triggers ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  deploy) cmd_deploy ;;
  *)
    echo "Error: unknown subcommand: $cmd" >&2
    echo "Run: mise run skills --help" >&2
    exit 1
    ;;
esac
